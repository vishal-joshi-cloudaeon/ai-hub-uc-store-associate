# Azure AI Foundry project endpoint per environment (server-side only —
# never exposed to the browser). One running proxy instance serves both
# /dev and /prod routes: the frontend sends which environment a request is
# for, and this picks the matching endpoint/agent id below.
FOUNDRY_AGENT_ENDPOINT_DEV=https://your-dev-foundry-resource.services.ai.azure.com/api/projects/your-dev-project
FOUNDRY_AGENT_ID_DEV=Loyalty-Agent

FOUNDRY_AGENT_ENDPOINT_PROD=https://your-prod-foundry-resource.services.ai.azure.com/api/projects/your-prod-project
FOUNDRY_AGENT_ID_PROD=Loyalty-Agent

# API version required by Azure AI Foundry's Responses API (/openai/responses)
FOUNDRY_API_VERSION=2025-05-15-preview

# The AAD token scope this service requests. Azure AI Foundry Agent Service
# resolves RBAC on this project via Entra ID, not an api-key, so there is no
# api-key setting here at all. If token acquisition succeeds but calls still
# 403, this is the first thing to double-check with whoever owns the project
# — for each environment, since the same identity needs RBAC granted on both.
AZURE_TOKEN_SCOPE=https://ai.azure.com/.default

# --- Identity (DefaultAzureCredential) ------------------------------------
# In production (Azure App Service / Container Apps / AKS with a managed
# identity assigned to this service), leave all three of these unset —
# DefaultAzureCredential picks up the managed identity automatically and no
# secret ever needs to exist. They're only for local development, as an
# alternative to `az login`.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Port this proxy listens on
PORT=8787

# Origin allowed to call this proxy (the frontend's dev/prod URL)
CORS_ORIGIN=http://localhost:5173
