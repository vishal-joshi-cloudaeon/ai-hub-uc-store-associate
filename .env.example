# Base URL of the loyalty-agent-proxy backend (server/) — this is the only
# thing the browser talks to for the manager chat. It's a single instance
# serving both /dev and /prod routes: the frontend sends which environment
# a request is for in the request body, and the proxy picks the right
# Foundry project/agent server-side. See server/.env.example.
VITE_AGENT_API_URL=http://localhost:8787/agent

# Base URL(s) of the approvals-service backend. Normally the SAME single
# instance for both — it switches Databricks connections internally based
# on the `env` query param each request carries. Only set these to
# different values if you deploy genuinely separate instances per
# environment.
VITE_APPROVALS_API_URL_DEV=http://localhost:8000
VITE_APPROVALS_API_URL_PROD=http://localhost:8000

# Poll interval (ms) used for both run-status polling and approval polling
VITE_POLL_INTERVAL_MS=5000
