{
  "name": "uc-store-associate",
  "private": true,
  "version": "0.2.0",
  "description": "SAW Loyalty store-associate app: React SPA, the Azure AI Foundry agent proxy, the cluster-head approvals API and the Foundry agent's OpenAPI tool endpoints — one Node project, deployed as one Azure Web App.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --watch --import tsx server/src/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -p tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
