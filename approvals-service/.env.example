# --- Dev environment Databricks connection --------------------------------
# Host: your workspace hostname, e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_SERVER_HOSTNAME_DEV=

# HTTP path of the SQL warehouse, e.g. /sql/1.0/warehouses/<warehouse_id>
# (Databricks workspace -> SQL Warehouses -> your warehouse -> Connection details)
DATABRICKS_HTTP_PATH_DEV=

# Azure AD service principal used for OAuth client-credentials auth (not a
# static PAT). A token is fetched from {host}/oidc/v1/token at startup and
# refreshed automatically before it expires. The principal needs query access
# to {CATALOG}.{SCHEMA}.dim_approval and {CATALOG}.{SCHEMA}.dim_voucher_issued
# in this workspace.
DATABRICKS_CLIENT_ID_DEV=
DATABRICKS_CLIENT_SECRET_DEV=

# --- Prod environment Databricks connection (separate workspace) ----------
DATABRICKS_SERVER_HOSTNAME_PROD=
DATABRICKS_HTTP_PATH_PROD=
DATABRICKS_CLIENT_ID_PROD=
DATABRICKS_CLIENT_SECRET_PROD=

# Unity Catalog catalog/schema names — same in both workspaces (each has its
# own catalog with this name; unrelated to the dev/prod app-environment switch).
CATALOG=dev
SCHEMA=retail

# Origin allowed to call the /api/approvals endpoints (the frontend's URL).
# The /tools/* endpoints are called server-to-server (Foundry -> APIM -> here),
# not from the browser, so this only gates the approvals API.
CORS_ORIGIN=http://localhost:5173

# Matches VITE_APPROVALS_API_URL_DEV/_PROD's existing default (http://localhost:8000) —
# no frontend env change needed if left at 8000. One instance serves both
# environments; it switches Databricks connections per-request based on the
# `env` query param / `X-Environment` header.
PORT=8000
